{
	"include": [
		"js",
		"types"
	],
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"declaration": true,
		"outDir": "dist",
		"jsx": "react",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"litegraph.js/build/litegraph.core": [
				"./node_modules/litegraph.js/src/litegraph.d.ts"
			]
		}
	}
}